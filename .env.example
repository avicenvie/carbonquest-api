# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=your-secret-key-change-in-production

# Prisma / PostgreSQL Connection
DATABASE_URL="postgresql://carbonquest:secret@localhost:5432/carbonquest_db?schema=public"

# Docker Compose Database Configuration
DB_USER=carbonquest
DB_PASSWORD=secret
DB_NAME=carbonquest_db

# Cloudflare Tunnel (Optional for docker-compose)
CLOUDFLARE_TUNNEL_TOKEN=
